          <string name="Name">RagdollModule</string>
          <string name="Source">--!strict
-- RagdollModule.luau
-- Comprehensive, high-performance R15 and R6 Ragdoll System for Roblox
-- Inspired by Project C.A.R.L. and Ragdoll Engine physics

local RagdollModule = {}

-- Joint angle limit presets for natural anatomical movement
local JOINT_LIMITS: { [string]: { upperAngle: number, twistLower: number, twistUpper: number } } = {
	[&quot;Neck&quot;] = { upperAngle = 35, twistLower = -30, twistUpper = 30 },
	[&quot;Waist&quot;] = { upperAngle = 40, twistLower = -35, twistUpper = 35 },
	[&quot;LeftShoulder&quot;] = { upperAngle = 80, twistLower = -60, twistUpper = 60 },
	[&quot;RightShoulder&quot;] = { upperAngle = 80, twistLower = -60, twistUpper = 60 },
	[&quot;LeftElbow&quot;] = { upperAngle = 80, twistLower = -10, twistUpper = 80 },
	[&quot;RightElbow&quot;] = { upperAngle = 80, twistLower = -10, twistUpper = 80 },
	[&quot;LeftWrist&quot;] = { upperAngle = 40, twistLower = -40, twistUpper = 40 },
	[&quot;RightWrist&quot;] = { upperAngle = 40, twistLower = -40, twistUpper = 40 },
	[&quot;LeftHip&quot;] = { upperAngle = 55, twistLower = -40, twistUpper = 40 },
	[&quot;RightHip&quot;] = { upperAngle = 55, twistLower = -40, twistUpper = 40 },
	[&quot;LeftKnee&quot;] = { upperAngle = 85, twistLower = -10, twistUpper = 85 },
	[&quot;RightKnee&quot;] = { upperAngle = 85, twistLower = -10, twistUpper = 85 },
	[&quot;LeftAnkle&quot;] = { upperAngle = 30, twistLower = -30, twistUpper = 30 },
	[&quot;RightAnkle&quot;] = { upperAngle = 30, twistLower = -30, twistUpper = 30 },
	-- Fallbacks for R6 joints
	[&quot;Left Shoulder&quot;] = { upperAngle = 80, twistLower = -60, twistUpper = 60 },
	[&quot;Right Shoulder&quot;] = { upperAngle = 80, twistLower = -60, twistUpper = 60 },
	[&quot;Left Hip&quot;] = { upperAngle = 55, twistLower = -40, twistUpper = 40 },
	[&quot;Right Hip&quot;] = { upperAngle = 55, twistLower = -40, twistUpper = 40 },
}

-- Default limit if joint name is unlisted
local DEFAULT_LIMIT = { upperAngle = 60, twistLower = -45, twistUpper = 45 }

-- Set up attachments, ball sockets, and collision constraints for a character
function RagdollModule.SetupCharacter(character: Model)
	local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if not humanoid then return end

	-- Mark as having ragdoll setup
	if character:FindFirstChild(&quot;RagdollConstraints&quot;) then return end

	local constraintFolder = Instance.new(&quot;Folder&quot;)
	constraintFolder.Name = &quot;RagdollConstraints&quot;
	constraintFolder.Parent = character

	local isRagdolledValue = character:FindFirstChild(&quot;IsRagdolled&quot;)
	if not isRagdolledValue then
		local val = Instance.new(&quot;BoolValue&quot;)
		val.Name = &quot;IsRagdolled&quot;
		val.Value = false
		val.Parent = character
	end

	-- Prevent character from breaking joints on death (keeps body intact as ragdoll!)
	humanoid.BreakJointsOnDeath = false

	-- Scan all Motor6Ds
	for _, desc in character:GetDescendants() do
		if desc:IsA(&quot;Motor6D&quot;) then
			local motor = desc :: Motor6D
			local part0 = motor.Part0
			local part1 = motor.Part1

			-- Ignore Root joint (keeps HumanoidRootPart anchored to LowerTorso so camera follows)
			if motor.Name == &quot;Root&quot; or motor.Name == &quot;RootJoint&quot; then
				continue
			end

			if part0 and part1 then
				-- Attachment 0
				local att0 = Instance.new(&quot;Attachment&quot;)
				att0.Name = &quot;RagdollAtt0_&quot; .. motor.Name
				att0.CFrame = motor.C0
				att0.Parent = part0

				-- Attachment 1
				local att1 = Instance.new(&quot;Attachment&quot;)
				att1.Name = &quot;RagdollAtt1_&quot; .. motor.Name
				att1.CFrame = motor.C1
				att1.Parent = part1

				-- BallSocketConstraint
				local socket = Instance.new(&quot;BallSocketConstraint&quot;)
				socket.Name = &quot;RagdollSocket_&quot; .. motor.Name
				socket.Attachment0 = att0
				socket.Attachment1 = att1
				socket.LimitsEnabled = true
				socket.TwistLimitsEnabled = true

				local limits = JOINT_LIMITS[motor.Name] or DEFAULT_LIMIT
				socket.UpperAngle = limits.upperAngle
				socket.TwistLowerAngle = limits.twistLower
				socket.TwistUpperAngle = limits.twistUpper
				socket.Restitution = 0.15
				socket.Enabled = false
				socket.Parent = constraintFolder

				-- NoCollisionConstraint between adjacent parts
				local noCol = Instance.new(&quot;NoCollisionConstraint&quot;)
				noCol.Name = &quot;NoCol_&quot; .. part0.Name .. &quot;_&quot; .. part1.Name
				noCol.Part0 = part0
				noCol.Part1 = part1
				noCol.Parent = constraintFolder
			end
		end
	end

	-- Also disable collision between limbs and Torso/RootPart to avoid self-flinging
	local rootPart = character:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
	if rootPart then
		for _, part in character:GetChildren() do
			if part:IsA(&quot;BasePart&quot;) and part ~= rootPart then
				local noCol = Instance.new(&quot;NoCollisionConstraint&quot;)
				noCol.Name = &quot;RootNoCol_&quot; .. part.Name
				noCol.Part0 = rootPart
				noCol.Part1 = part
				noCol.Parent = constraintFolder
			end
		end
	end
end

-- Checks if character is currently ragdolled
function RagdollModule.IsRagdolled(character: Model): boolean
	local val = character:FindFirstChild(&quot;IsRagdolled&quot;) :: BoolValue?
	return val ~= nil and val.Value == true
end

-- Toggle ragdoll on or off
function RagdollModule.ToggleRagdoll(character: Model, impulse: Vector3?): boolean
	local current = RagdollModule.IsRagdolled(character)
	RagdollModule.SetRagdoll(character, not current, impulse)
	return not current
end

-- Set ragdoll state explicitly
function RagdollModule.SetRagdoll(character: Model, enable: boolean, impulse: Vector3?)
	local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if not humanoid then return end

	local rootPart = character:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
	local constraintsFolder = character:FindFirstChild(&quot;RagdollConstraints&quot;)
	if not constraintsFolder then
		RagdollModule.SetupCharacter(character)
		constraintsFolder = character:FindFirstChild(&quot;RagdollConstraints&quot;)
	end

	local isRagdolledVal = character:FindFirstChild(&quot;IsRagdolled&quot;) :: BoolValue?
	if isRagdolledVal then
		isRagdolledVal.Value = enable
	end

	if enable then
		-- ENABLE RAGDOLL
		humanoid.AutoRotate = false

		-- Stop playing animations
		local animator = humanoid:FindFirstChildOfClass(&quot;Animator&quot;)
		if animator then
			for _, track in animator:GetPlayingAnimationTracks() do
				track:Stop(0.1)
			end
		end

		-- Switch humanoid state
		humanoid.PlatformStand = true
		humanoid:ChangeState(Enum.HumanoidStateType.Physics)

		-- Disable Motor6D joints and enable BallSockets
		for _, desc in character:GetDescendants() do
			if desc:IsA(&quot;Motor6D&quot;) then
				if desc.Name ~= &quot;Root&quot; and desc.Name ~= &quot;RootJoint&quot; then
					desc.Enabled = false
				end
			end
		end

		if constraintsFolder then
			for _, constraint in constraintsFolder:GetChildren() do
				if constraint:IsA(&quot;BallSocketConstraint&quot;) then
					constraint.Enabled = true
				end
			end
		end

		-- Set part collisions: body parts collide, root part does not
		if rootPart then
			rootPart.CanCollide = false
		end

		for _, part in character:GetChildren() do
			if part:IsA(&quot;BasePart&quot;) and part ~= rootPart then
				-- Skip invisible organ hitboxes
				if not part:GetAttribute(&quot;IsOrgan&quot;) then
					part.CanCollide = true
				end
			end
		end

		-- Apply optional physics impulse (e.g. from gunshot or shove)
		if impulse then
			local torso = character:FindFirstChild(&quot;UpperTorso&quot;) or character:FindFirstChild(&quot;Torso&quot;) or rootPart
			if torso and torso:IsA(&quot;BasePart&quot;) then
				torso:ApplyImpulse(impulse * torso.AssemblyMass)
			end
		end

	else
		-- DISABLE RAGDOLL (GET UP)
		if humanoid.Health &lt;= 0 then
			-- Dead characters cannot get up
			return
		end

		-- Disable BallSockets and re-enable Motor6D joints
		if constraintsFolder then
			for _, constraint in constraintsFolder:GetChildren() do
				if constraint:IsA(&quot;BallSocketConstraint&quot;) then
					constraint.Enabled = false
				end
			end
		end

		for _, desc in character:GetDescendants() do
			if desc:IsA(&quot;Motor6D&quot;) then
				desc.Enabled = true
			end
		end

		-- Reset part collisions
		if rootPart then
			rootPart.CanCollide = true
		end

		for _, part in character:GetChildren() do
			if part:IsA(&quot;BasePart&quot;) and part ~= rootPart then
				part.CanCollide = false
			end
		end

		-- Smooth getup recovery
		humanoid.PlatformStand = false
		humanoid.AutoRotate = true

		if rootPart then
			-- Slightly elevate to avoid clipping through floor
			local currentPos = rootPart.Position
			local look = rootPart.CFrame.LookVector
			local flatLook = Vector3.new(look.X, 0, look.Z).Unit
			if flatLook.Magnitude == 0 or flatLook ~= flatLook then
				flatLook = Vector3.new(0, 0, -1)
			end
			rootPart.CFrame = CFrame.new(currentPos + Vector3.new(0, 2.5, 0), currentPos + Vector3.new(0, 2.5, 0) + flatLook)
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end

		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
end

return RagdollModule
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_9">
        <Properties>
          <string name="Name">BloodEngine</string>
          <string name="Source">--!strict
-- BloodEngine.luau
-- Physics-based Blood Splatters, Arterial Fountains, Organ Penetration, and Decals
-- Inspired by Project C.A.R.L. and Advanced Blood Engine

local Debris = game:GetService(&quot;Debris&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)
local Workspace = game:GetService(&quot;Workspace&quot;)

local BloodEngine = {}

-- Organ damage and effect definitions
export type OrganHitResult = {
	hitOrgan: boolean,
	organName: string?,
	damage: number,
	isFatal: boolean,
	forceRagdoll: boolean,
	message: string?,
	color: Color3,
}

local ORGAN_DATA: { [string]: { damage: number, isFatal: boolean, forceRagdoll: boolean, message: string, color: Color3 } } = {
	[&quot;Brain&quot;] = {
		damage = 100,
		isFatal = true,
		forceRagdoll = true,
		message = &quot;🎯 HEADSHOT: МОЗГ УНИЧТОЖЕН!&quot;,
		color = Color3.fromRGB(255, 60, 60),
	},
	[&quot;Heart&quot;] = {
		damage = 80,
		isFatal = true,
		forceRagdoll = true,
		message = &quot;❤️ ПРОБИТИЕ СЕРДЦА: АРТЕРИАЛЬНОЕ КРОВОТЕЧЕНИЕ!&quot;,
		color = Color3.fromRGB(220, 20, 20),
	},
	[&quot;Spine&quot;] = {
		damage = 60,
		isFatal = false,
		forceRagdoll = true,
		message = &quot;🦴 ПОЗВОНОЧНИК СЛОМАН: ПАРАЛИЧ!&quot;,
		color = Color3.fromRGB(255, 170, 50),
	},
	[&quot;LeftLung&quot;] = {
		damage = 45,
		isFatal = false,
		forceRagdoll = true,
		message = &quot;🫁 ЛЕВОЕ ЛЕГКОЕ ПРОБИТО!&quot;,
		color = Color3.fromRGB(220, 100, 120),
	},
	[&quot;RightLung&quot;] = {
		damage = 45,
		isFatal = false,
		forceRagdoll = true,
		message = &quot;🫁 ПРАВОЕ ЛЕГКОЕ ПРОБИТО!&quot;,
		color = Color3.fromRGB(220, 100, 120),
	},
	[&quot;Stomach&quot;] = {
		damage = 35,
		isFatal = false,
		forceRagdoll = true,
		message = &quot;🩸 БРЮШНОЕ РАНЕНИЕ!&quot;,
		color = Color3.fromRGB(180, 50, 50),
	},
}

-- Checks if a ray penetrates any internal organs inside the target character
function BloodEngine.CheckOrganPenetration(character: Model, rayOrigin: Vector3, rayDirection: Vector3): OrganHitResult
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = { character }
	raycastParams.FilterType = RaycastFilterType.Include
	raycastParams.IgnoreWater = true

	-- Cast ray through character to detect any organ hitboxes
	local result = Workspace:Raycast(rayOrigin, rayDirection * 10, raycastParams)
	if result and result.Instance then
		local hitPart = result.Instance
		local organName = hitPart.Name

		-- Check if it matches an organ
		if ORGAN_DATA[organName] then
			local data = ORGAN_DATA[organName]
			return {
				hitOrgan = true,
				organName = organName,
				damage = data.damage,
				isFatal = data.isFatal,
				forceRagdoll = data.forceRagdoll,
				message = data.message,
				color = data.color,
			}
		end
	end

	-- Also check proximity to organs inside character if ray hit a body part
	local organs = {}
	for _, child in character:GetChildren() do
		if child:IsA(&quot;BasePart&quot;) and child:GetAttribute(&quot;IsOrgan&quot;) then
			table.insert(organs, child)
		end
	end

	-- Secondary penetration check against organ bounding boxes
	for _, organ in organs do
		local organPos = organ.Position
		local toOrgan = organPos - rayOrigin
		local projection = toOrgan:Dot(rayDirection.Unit)
		if projection &gt; 0 and projection &lt; rayDirection.Magnitude + 5 then
			local closestPoint = rayOrigin + rayDirection.Unit * projection
			local distance = (closestPoint - organPos).Magnitude
			local maxRadius = (organ.Size.Magnitude / 2) + 0.3
			if distance &lt;= maxRadius then
				local data = ORGAN_DATA[organ.Name] or {
					damage = 40,
					isFatal = false,
					forceRagdoll = true,
					message = &quot;🩸 ВНУТРЕННИЙ ОРГАН ПОВРЕЖДЕН!&quot;,
					color = Color3.fromRGB(200, 30, 30),
				}
				return {
					hitOrgan = true,
					organName = organ.Name,
					damage = data.damage,
					isFatal = data.isFatal,
					forceRagdoll = data.forceRagdoll,
					message = data.message,
					color = data.color,
				}
			end
		end
	end

	return {
		hitOrgan = false,
		organName = nil,
		damage = 25,
		isFatal = false,
		forceRagdoll = false,
		message = nil,
		color = Color3.fromRGB(150, 20, 20),
	}
end

-- Create burst of blood particles at hit position
function BloodEngine.SpawnBloodParticles(position: Vector3, normal: Vector3, intensity: number?)
	local count = intensity or 15

	local emitterPart = Instance.new(&quot;Part&quot;)
	emitterPart.Name = &quot;BloodEmitter&quot;
	emitterPart.Size = Vector3.new(0.2, 0.2, 0.2)
	emitterPart.Position = position
	emitterPart.Anchored = true
	emitterPart.CanCollide = false
	emitterPart.Transparency = 1
	emitterPart.Parent = Workspace

	local emitter = Instance.new(&quot;ParticleEmitter&quot;)
	emitter.Color = ColorSequence.new(Color3.fromRGB(130, 0, 0), Color3.fromRGB(90, 0, 0))
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.35),
		NumberSequenceKeypoint.new(1, 0.1),
	})
	emitter.Texture = &quot;rbxassetid://241594419&quot; -- Smooth circle particle
	emitter.Lifetime = NumberRange.new(0.4, 0.9)
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(8, 22)
	emitter.SpreadAngle = Vector2.new(45, 45)
	emitter.EmissionDirection = Enum.NormalId.Top
	emitter.Acceleration = Vector3.new(0, -45, 0)
	emitter.Parent = emitterPart

	-- Orient emitter along normal
	emitterPart.CFrame = CFrame.lookAt(position, position + normal)
	emitter:Emit(count)

	Debris:AddItem(emitterPart, 1.5)
end

-- Spawn blood splatters on surfaces nearby
function BloodEngine.CreateSurfaceSplatters(origin: Vector3, direction: Vector3, count: number?)
	local splatterCount = count or 4
	local filter = RaycastParams.new()
	filter.FilterType = RaycastFilterType.Exclude
	filter.IgnoreWater = true

	for _ = 1, splatterCount do
		-- Random spray angle
		local randDir = (direction + Vector3.new(
			(math.random() - 0.5) * 1.2,
			(math.random() - 0.5) * 1.2,
			(math.random() - 0.5) * 1.2
		)).Unit

		local rayResult = Workspace:Raycast(origin, randDir * 12, filter)
		if rayResult and rayResult.Instance and rayResult.Instance.CanCollide then
			local hitPos = rayResult.Position
			local hitNormal = rayResult.Normal

			-- Create small blood decal part
			local splatter = Instance.new(&quot;Part&quot;)
			splatter.Name = &quot;BloodSplatter&quot;
			local size = math.random(8, 18) / 10
			splatter.Size = Vector3.new(size, 0.05, size)
			splatter.CFrame = CFrame.lookAt(hitPos + hitNormal * 0.02, hitPos + hitNormal) * CFrame.Angles(math.pi / 2, 0, math.random() * math.pi)
			splatter.Anchored = true
			splatter.CanCollide = false
			splatter.Material = Enum.Material.Glass
			splatter.Color = Color3.fromRGB(110, 0, 0)
			splatter.Transparency = 0.15
			splatter.CastShadow = false
			splatter.Parent = Workspace

			-- Fade out and remove after 20 seconds
			task.delay(18, function()
				if splatter and splatter.Parent then
					local tween = TweenService:Create(splatter, TweenInfo.new(2), { Transparency = 1 })
					tween:Play()
					tween.Completed:Connect(function()
						splatter:Destroy()
					end)
				end
			end)
		end
	end
end

-- Create expanding puddle of blood on the floor under a body
function BloodEngine.CreateBloodPuddle(groundPosition: Vector3, maxRadius: number?)
	local targetSize = maxRadius or 3.5

	local puddle = Instance.new(&quot;Part&quot;)
	puddle.Name = &quot;BloodPuddle&quot;
	puddle.Size = Vector3.new(0.2, 0.02, 0.2)
	puddle.Position = groundPosition + Vector3.new(0, 0.02, 0)
	puddle.Anchored = true
	puddle.CanCollide = false
	puddle.Material = Enum.Material.Glass
	puddle.Color = Color3.fromRGB(120, 0, 0)
	puddle.Transparency = 0.2
	puddle.CastShadow = false
	puddle.Shape = Enum.PartType.Cylinder
	-- Orient cylinder flat on ground
	puddle.CFrame = CFrame.new(puddle.Position) * CFrame.Angles(0, 0, math.pi / 2)
	puddle.Parent = Workspace

	-- Expand over 4 seconds
	local tween = TweenService:Create(puddle, TweenInfo.new(4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Size = Vector3.new(0.02, targetSize, targetSize)
	})
	tween:Play()

	-- Clean up after 30 seconds
	Debris:AddItem(puddle, 30)
end

-- Create arterial blood spray fountain from a ruptured heart or vessel
function BloodEngine.CreateArterialFountain(attachmentParent: BasePart, duration: number?)
	local streamDuration = duration or 3.5

	local att = Instance.new(&quot;Attachment&quot;)
	att.Name = &quot;ArterialAttachment&quot;
	att.Parent = attachmentParent

	local fountain = Instance.new(&quot;ParticleEmitter&quot;)
	fountain.Name = &quot;ArterialSpray&quot;
	fountain.Color = ColorSequence.new(Color3.fromRGB(150, 0, 0), Color3.fromRGB(100, 0, 0))
	fountain.Size = NumberSequence.new(0.2, 0.4)
	fountain.Texture = &quot;rbxassetid://241594419&quot;
	fountain.Lifetime = NumberRange.new(0.5, 0.8)
	fountain.Rate = 35
	fountain.Speed = NumberRange.new(12, 18)
	fountain.SpreadAngle = Vector2.new(15, 15)
	fountain.Acceleration = Vector3.new(0, -35, 0)
	fountain.Parent = att

	-- Stop after duration
	task.delay(streamDuration, function()
		if fountain and fountain.Parent then
			fountain.Enabled = false
			Debris:AddItem(att, 1)
		end
	end)
end

return BloodEngine
</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="RBX_10">
        <Properties>
          <string name="Name">WeaponConfig</string>
          <string name="Source">--!strict
-- WeaponConfig.luau
-- Weapon ballistic parameters, kinetic impulses, and sound settings

local WeaponConfig = {
	Pistol = {
		Name = &quot;Пистолет 9mm (Pistol)&quot;,
		Damage = 35,
		HeadshotMultiplier = 2.5,
		FireRate = 0.2, -- seconds between shots
		Range = 300,
		Spread = 0.015,
		ImpulseForce = 45, -- kinetic impulse applied to ragdoll body
		SoundId = &quot;rbxassetid://131070686&quot;, -- gunshot
	},
	Shotgun = {
		Name = &quot;Дробовик 12G (Shotgun)&quot;,
		DamagePerPellet = 15,
		PelletCount = 8,
		FireRate = 0.85,
		Range = 150,
		Spread = 0.08,
		ImpulseForce = 85, -- massive blast knockback
		SoundId = &quot;rbxassetid://142494488&quot;, -- shotgun blast
	},
	PushTool = {
		Name = &quot;Толкатель (Push Hands)&quot;,
		Cooldown = 1.0,
		Range = 8,
		ImpulseForward = 65,
		ImpulseUp = 25,
		SoundId = &quot;rbxassetid://138090596&quot;, -- whoosh/hit
	},
	RagdollWand = {
		Name = &quot;Жезл Рэгдолла (Ragdoll Wand)&quot;,
		Range = 100,
		FlingForce = 120,
		SoundId = &quot;rbxassetid://131237241&quot;, -- magic hit
	},
}

return WeaponConfig
</string>
        </Properties>
      </Item>
    </Item>
