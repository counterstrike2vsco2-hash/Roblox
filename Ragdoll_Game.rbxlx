    </Properties>
    <Item class="Script" referent="RBX_18">
      <Properties>
        <string name="Name">RagdollServer</string>
        <string name="Source">--!strict
-- RagdollServer.server.luau
-- Authoritative server management for player and dummy ragdolls, ballistic penetration, and combat events

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Workspace = game:GetService(&quot;Workspace&quot;)

local Shared = ReplicatedStorage:WaitForChild(&quot;Shared&quot;)
local RagdollModule = require(Shared:WaitForChild(&quot;RagdollModule&quot;))
local BloodEngine = require(Shared:WaitForChild(&quot;BloodEngine&quot;))
local WeaponConfig = require(Shared:WaitForChild(&quot;WeaponConfig&quot;))

-- Create or get RemoteEvents
local function getOrCreateRemote(name: string): RemoteEvent
	local remote = ReplicatedStorage:FindFirstChild(name)
	if not remote then
		remote = Instance.new(&quot;RemoteEvent&quot;)
		remote.Name = name
		remote.Parent = ReplicatedStorage
	end
	return remote :: RemoteEvent
end

local ToggleRagdollRemote = getOrCreateRemote(&quot;ToggleRagdoll&quot;)
local RequestPushRemote = getOrCreateRemote(&quot;RequestPush&quot;)
local ShootWeaponRemote = getOrCreateRemote(&quot;ShootWeapon&quot;)
local OrganHitRemote = getOrCreateRemote(&quot;OrganHitEvent&quot;)
local ToggleXRayRemote = getOrCreateRemote(&quot;ToggleXRay&quot;)
local ResetDummyRemote = getOrCreateRemote(&quot;ResetDummy&quot;)

-- Set up player character when spawned
local function onCharacterAdded(character: Model, player: Player)
	local humanoid = character:WaitForChild(&quot;Humanoid&quot;) :: Humanoid
	local rootPart = character:WaitForChild(&quot;HumanoidRootPart&quot;) :: BasePart

	-- Set up ragdoll joints
	RagdollModule.SetupCharacter(character)

	-- Keep character intact as ragdoll on death
	humanoid.Died:Connect(function()
		RagdollModule.SetRagdoll(character, true, Vector3.new(0, -10, 0))
	end)

	-- Fall impact check: if falling with high downward velocity, trigger ragdoll on hard landing
	local lastVelocityY = 0
	task.spawn(function()
		while character and character.Parent and humanoid.Health &gt; 0 do
			if rootPart and rootPart.Parent then
				local currentVelY = rootPart.AssemblyLinearVelocity.Y
				if lastVelocityY &lt; -65 and currentVelY &gt; -10 then
					-- Hard impact with ground!
					RagdollModule.SetRagdoll(character, true, Vector3.new(0, 5, 0))
					BloodEngine.SpawnBloodParticles(rootPart.Position, Vector3.new(0, 1, 0), 10)
				end
				lastVelocityY = currentVelY
			end
			task.wait(0.1)
		end
	end)
end

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(char)
		onCharacterAdded(char, player)
	end)
	if player.Character then
		onCharacterAdded(player.Character, player)
	end
end)

-- Handle player [F] key or UI button to toggle ragdoll
ToggleRagdollRemote.OnServerEvent:Connect(function(player, targetCharacter: Model?)
	local charToToggle = targetCharacter or player.Character
	if charToToggle and charToToggle:FindFirstChildOfClass(&quot;Humanoid&quot;) then
		local humanoid = charToToggle:FindFirstChildOfClass(&quot;Humanoid&quot;)
		if humanoid and humanoid.Health &gt; 0 then
			RagdollModule.ToggleRagdoll(charToToggle)
		end
	end
end)

-- Handle Push Tool action
RequestPushRemote.OnServerEvent:Connect(function(player, targetCharacter: Model)
	local playerChar = player.Character
	if not playerChar then return end
	local playerHrp = playerChar:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
	if not playerHrp then return end

	local targetHrp = targetCharacter:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
	local targetHumanoid = targetCharacter:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if not targetHrp or not targetHumanoid or targetHumanoid.Health &lt;= 0 then return end

	-- Check distance
	local dist = (playerHrp.Position - targetHrp.Position).Magnitude
	if dist &lt;= 12 then
		local pushDir = playerHrp.CFrame.LookVector
		local impulse = pushDir * WeaponConfig.PushTool.ImpulseForward + Vector3.new(0, WeaponConfig.PushTool.ImpulseUp, 0)

		-- Force ragdoll on target and fling forward
		RagdollModule.SetRagdoll(targetCharacter, true, impulse)
		targetHumanoid:TakeDamage(5)
		BloodEngine.SpawnBloodParticles(targetHrp.Position, pushDir, 5)
	end
end)

-- Handle Weapon Fire (Pistols, Shotguns, etc.)
ShootWeaponRemote.OnServerEvent:Connect(function(player, weaponName: string, rayOrigin: Vector3, rayDirection: Vector3)
	local playerChar = player.Character
	if not playerChar then return end

	local config = WeaponConfig[weaponName] or WeaponConfig.Pistol
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = { playerChar }
	raycastParams.FilterType = RaycastFilterType.Exclude
	raycastParams.IgnoreWater = true

	local result = Workspace:Raycast(rayOrigin, rayDirection * config.Range, raycastParams)
	if result and result.Instance then
		local hitPart = result.Instance
		local hitPos = result.Position
		local hitNormal = result.Normal

		-- Find if hit a character
		local targetModel = hitPart:FindFirstAncestorOfClass(&quot;Model&quot;)
		local targetHumanoid = targetModel and targetModel:FindFirstChildOfClass(&quot;Humanoid&quot;)

		if targetModel and targetHumanoid and targetHumanoid.Health &gt; 0 then
			-- Check organ penetration
			local organResult = BloodEngine.CheckOrganPenetration(targetModel, hitPos, rayDirection)

			local damage = config.Damage or 25
			local forceRagdoll = false

			if organResult.hitOrgan then
				damage = organResult.damage
				forceRagdoll = organResult.forceRagdoll

				-- Send notification to shooter client for HUD combat text
				OrganHitRemote:FireClient(player, organResult)

				-- Arterial fountain if heart was hit
				if organResult.organName == &quot;Heart&quot; then
					local torso = targetModel:FindFirstChild(&quot;UpperTorso&quot;) or hitPart
					if torso:IsA(&quot;BasePart&quot;) then
						BloodEngine.CreateArterialFountain(torso, 4)
					end
				end
			elseif hitPart.Name == &quot;Head&quot; then
				damage = damage * (config.HeadshotMultiplier or 2)
				forceRagdoll = true
				OrganHitRemote:FireClient(player, {
					hitOrgan = true,
					organName = &quot;Head&quot;,
					message = &quot;🎯 ВЫСТРЕЛ В ГОЛОВУ! (HEADSHOT)&quot;,
					color = Color3.fromRGB(255, 80, 80),
					damage = damage,
				})
			end

			-- Apply damage
			targetHumanoid:TakeDamage(damage)

			-- Trigger ragdoll if lethal, fatal organ, or heavy blast
			if forceRagdoll or targetHumanoid.Health &lt;= 0 or weaponName == &quot;Shotgun&quot; then
				local impulseVector = rayDirection.Unit * config.ImpulseForce + Vector3.new(0, 10, 0)
				RagdollModule.SetRagdoll(targetModel, true, impulseVector)
			end

			-- Spawn blood FX
			BloodEngine.SpawnBloodParticles(hitPos, hitNormal, 18)
			BloodEngine.CreateSurfaceSplatters(hitPos, rayDirection, 5)

			-- If heavily damaged or ragdolled, spawn floor puddle
			local floorRay = Workspace:Raycast(hitPos, Vector3.new(0, -10, 0))
			if floorRay then
				BloodEngine.CreateBloodPuddle(floorRay.Position, 2.5)
			end
		else
			-- Hit environmental surface (wall/floor/box)
			BloodEngine.CreateSurfaceSplatters(hitPos, rayDirection, 2)
		end
	end
end)

-- Handle X-Ray mode toggle for Dummies (sets skin transparency to show internal organs)
local isXRayActive = false
ToggleXRayRemote.OnServerEvent:Connect(function(player)
	isXRayActive = not isXRayActive
	for _, desc in Workspace:GetDescendants() do
		if desc:IsA(&quot;Model&quot;) and desc:GetAttribute(&quot;IsDummy&quot;) then
			for _, part in desc:GetChildren() do
				if part:IsA(&quot;BasePart&quot;) then
					if part:GetAttribute(&quot;IsOrgan&quot;) then
						-- Organ always visible
						part.Transparency = isXRayActive and 0.1 or 0.8
					else
						-- Skin part
						part.Transparency = isXRayActive and 0.65 or 0
					end
				end
			end
		end
	end
end)

-- Handle Dummy Reset / Revive
ResetDummyRemote.OnServerEvent:Connect(function(player, dummyModel: Model)
	if dummyModel and dummyModel:FindFirstChildOfClass(&quot;Humanoid&quot;) then
		local humanoid = dummyModel:FindFirstChildOfClass(&quot;Humanoid&quot;) :: Humanoid
		humanoid.Health = humanoid.MaxHealth
		RagdollModule.SetRagdoll(dummyModel, false)

		local rootPart = dummyModel:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
		local originalPos = dummyModel:GetAttribute(&quot;SpawnPosition&quot;) :: Vector3?
		if rootPart and originalPos then
			rootPart.CFrame = CFrame.new(originalPos)
			rootPart.AssemblyLinearVelocity = Vector3.zero
			rootPart.AssemblyAngularVelocity = Vector3.zero
		end
	end
end)

print(&quot;[Server] Ragdoll Server initialized successfully.&quot;)
</string>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX_19">
      <Properties>
        <string name="Name">DummyManager</string>
        <string name="Source">--!strict
-- DummyManager.server.luau
-- Spawns, rigs, and manages anatomical R15 Dummies (Project C.A.R.L. style) with internal organs and ProximityPrompts

local Workspace = game:GetService(&quot;Workspace&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local Shared = ReplicatedStorage:WaitForChild(&quot;Shared&quot;)
local RagdollModule = require(Shared:WaitForChild(&quot;RagdollModule&quot;))

local DummyManager = {}

-- Helper to create an R15 body part
local function createPart(name: string, size: Vector3, color: Color3, parent: Instance): Part
	local part = Instance.new(&quot;Part&quot;)
	part.Name = name
	part.Size = size
	part.Color = color
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = true
	part.Parent = parent
	return part
end

-- Helper to create Motor6D
local function createMotor(name: string, part0: BasePart, part1: BasePart, c0: CFrame, c1: CFrame, parent: Instance): Motor6D
	local motor = Instance.new(&quot;Motor6D&quot;)
	motor.Name = name
	motor.Part0 = part0
	motor.Part1 = part1
	motor.C0 = c0
	motor.C1 = c1
	motor.Parent = parent
	return motor
end

-- Build full R15 anatomical dummy
function DummyManager.CreateCarlDummy(spawnCFrame: CFrame, name: string?): Model
	local dummy = Instance.new(&quot;Model&quot;)
	dummy.Name = name or &quot;C.A.R.L. (Anatomy Dummy)&quot;
	dummy:SetAttribute(&quot;IsDummy&quot;, true)
	dummy:SetAttribute(&quot;SpawnPosition&quot;, spawnCFrame.Position)

	local humanoid = Instance.new(&quot;Humanoid&quot;)
	humanoid.Name = &quot;Humanoid&quot;
	humanoid.RigType = Enum.HumanoidRigType.R15
	humanoid.HipHeight = 2.0
	humanoid.MaxHealth = 100
	humanoid.Health = 100
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = dummy

	local skinColor = Color3.fromRGB(230, 225, 215) -- Project C.A.R.L. mannequin tone

	-- HumanoidRootPart
	local hrp = createPart(&quot;HumanoidRootPart&quot;, Vector3.new(2, 2, 1), skinColor, dummy)
	hrp.Transparency = 1
	hrp.CanCollide = false
	hrp.CFrame = spawnCFrame
	dummy.PrimaryPart = hrp

	-- LowerTorso &amp; UpperTorso
	local lowerTorso = createPart(&quot;LowerTorso&quot;, Vector3.new(2, 0.8, 1), skinColor, dummy)
	lowerTorso.CFrame = spawnCFrame * CFrame.new(0, -0.6, 0)

	local upperTorso = createPart(&quot;UpperTorso&quot;, Vector3.new(2, 1.6, 1), skinColor, dummy)
	upperTorso.CFrame = spawnCFrame * CFrame.new(0, 0.6, 0)

	-- Head
	local head = createPart(&quot;Head&quot;, Vector3.new(1.2, 1.2, 1.2), skinColor, dummy)
	head.CFrame = spawnCFrame * CFrame.new(0, 2.0, 0)
	local headMesh = Instance.new(&quot;SpecialMesh&quot;)
	headMesh.MeshType = Enum.MeshType.Head
	headMesh.Scale = Vector3.new(1.25, 1.25, 1.25)
	headMesh.Parent = head

	-- C.A.R.L. Visor / Markings (Dark line across face)
	local visorDecal = Instance.new(&quot;Decal&quot;)
	visorDecal.Name = &quot;FaceMark&quot;
	visorDecal.Face = Enum.NormalId.Front
	visorDecal.Texture = &quot;rbxassetid://1212882264&quot;
	visorDecal.Parent = head

	-- Limbs
	local lUpperArm = createPart(&quot;LeftUpperArm&quot;, Vector3.new(0.8, 1.1, 0.8), skinColor, dummy)
	local lLowerArm = createPart(&quot;LeftLowerArm&quot;, Vector3.new(0.8, 1.1, 0.8), skinColor, dummy)
	local lHand = createPart(&quot;LeftHand&quot;, Vector3.new(0.8, 0.4, 0.8), skinColor, dummy)

	local rUpperArm = createPart(&quot;RightUpperArm&quot;, Vector3.new(0.8, 1.1, 0.8), skinColor, dummy)
	local rLowerArm = createPart(&quot;RightLowerArm&quot;, Vector3.new(0.8, 1.1, 0.8), skinColor, dummy)
	local rHand = createPart(&quot;RightHand&quot;, Vector3.new(0.8, 0.4, 0.8), skinColor, dummy)

	local lUpperLeg = createPart(&quot;LeftUpperLeg&quot;, Vector3.new(0.8, 1.2, 0.8), skinColor, dummy)
	local lLowerLeg = createPart(&quot;LeftLowerLeg&quot;, Vector3.new(0.8, 1.2, 0.8), skinColor, dummy)
	local lFoot = createPart(&quot;LeftFoot&quot;, Vector3.new(0.8, 0.4, 0.8), skinColor, dummy)

	local rUpperLeg = createPart(&quot;RightUpperLeg&quot;, Vector3.new(0.8, 1.2, 0.8), skinColor, dummy)
	local rLowerLeg = createPart(&quot;RightLowerLeg&quot;, Vector3.new(0.8, 1.2, 0.8), skinColor, dummy)
	local rFoot = createPart(&quot;RightFoot&quot;, Vector3.new(0.8, 0.4, 0.8), skinColor, dummy)

	-- Motor6D Joints
	createMotor(&quot;Root&quot;, hrp, lowerTorso, CFrame.new(0, 0, 0), CFrame.new(0, 0, 0), lowerTorso)
	createMotor(&quot;Waist&quot;, lowerTorso, upperTorso, CFrame.new(0, 0.4, 0), CFrame.new(0, -0.8, 0), upperTorso)
	createMotor(&quot;Neck&quot;, upperTorso, head, CFrame.new(0, 0.8, 0), CFrame.new(0, -0.6, 0), head)

	-- Left Arm
	createMotor(&quot;LeftShoulder&quot;, upperTorso, lUpperArm, CFrame.new(-1.3, 0.6, 0), CFrame.new(0, 0.55, 0), lUpperArm)
	createMotor(&quot;LeftElbow&quot;, lUpperArm, lLowerArm, CFrame.new(0, -0.55, 0), CFrame.new(0, 0.55, 0), lLowerArm)
	createMotor(&quot;LeftWrist&quot;, lLowerArm, lHand, CFrame.new(0, -0.55, 0), CFrame.new(0, 0.2, 0), lHand)

	-- Right Arm
	createMotor(&quot;RightShoulder&quot;, upperTorso, rUpperArm, CFrame.new(1.3, 0.6, 0), CFrame.new(0, 0.55, 0), rUpperArm)
	createMotor(&quot;RightElbow&quot;, rUpperArm, rLowerArm, CFrame.new(0, -0.55, 0), CFrame.new(0, 0.55, 0), rLowerArm)
	createMotor(&quot;RightWrist&quot;, rLowerArm, rHand, CFrame.new(0, -0.55, 0), CFrame.new(0, 0.2, 0), rHand)

	-- Left Leg
	createMotor(&quot;LeftHip&quot;, lowerTorso, lUpperLeg, CFrame.new(-0.5, -0.4, 0), CFrame.new(0, 0.6, 0), lUpperLeg)
	createMotor(&quot;LeftKnee&quot;, lUpperLeg, lLowerLeg, CFrame.new(0, -0.6, 0), CFrame.new(0, 0.6, 0), lLowerLeg)
	createMotor(&quot;LeftAnkle&quot;, lLowerLeg, lFoot, CFrame.new(0, -0.6, 0), CFrame.new(0, 0.2, 0), lFoot)

	-- Right Leg
	createMotor(&quot;RightHip&quot;, lowerTorso, rUpperLeg, CFrame.new(0.5, -0.4, 0), CFrame.new(0, 0.6, 0), rUpperLeg)
	createMotor(&quot;RightKnee&quot;, rUpperLeg, rLowerLeg, CFrame.new(0, -0.6, 0), CFrame.new(0, 0.6, 0), rLowerLeg)
	createMotor(&quot;RightAnkle&quot;, rLowerLeg, rFoot, CFrame.new(0, -0.6, 0), CFrame.new(0, 0.2, 0), rFoot)

	----------------------------------------------------------------------
	-- PROJECT C.A.R.L. INTERNAL ANATOMICAL ORGANS
	----------------------------------------------------------------------
	local function createOrgan(organName: string, size: Vector3, color: Color3, parentLimb: BasePart, offset: Vector3): Part
		local organ = Instance.new(&quot;Part&quot;)
		organ.Name = organName
		organ.Size = size
		organ.Color = color
		organ.Material = Enum.Material.Neon
		organ.CanCollide = false
		organ.Transparency = 0.8 -- translucent by default, becomes visible in X-Ray!
		organ:SetAttribute(&quot;IsOrgan&quot;, true)
		organ.CFrame = parentLimb.CFrame * CFrame.new(offset)
		organ.Parent = dummy

		local weld = Instance.new(&quot;WeldConstraint&quot;)
		weld.Part0 = parentLimb
		weld.Part1 = organ
		weld.Parent = organ

		return organ
	end

	-- Brain inside Head
	createOrgan(&quot;Brain&quot;, Vector3.new(0.7, 0.6, 0.7), Color3.fromRGB(220, 80, 100), head, Vector3.new(0, 0.1, 0))

	-- Heart inside UpperTorso
	createOrgan(&quot;Heart&quot;, Vector3.new(0.5, 0.5, 0.4), Color3.fromRGB(180, 10, 20), upperTorso, Vector3.new(-0.25, 0.1, -0.1))

	-- Lungs
	createOrgan(&quot;LeftLung&quot;, Vector3.new(0.4, 0.8, 0.4), Color3.fromRGB(200, 110, 130), upperTorso, Vector3.new(-0.45, 0.2, 0))
	createOrgan(&quot;RightLung&quot;, Vector3.new(0.4, 0.8, 0.4), Color3.fromRGB(200, 110, 130), upperTorso, Vector3.new(0.45, 0.2, 0))

	-- Spine running through Torso
	createOrgan(&quot;Spine&quot;, Vector3.new(0.3, 1.4, 0.3), Color3.fromRGB(240, 240, 240), upperTorso, Vector3.new(0, 0, 0.25))

	-- Stomach
	createOrgan(&quot;Stomach&quot;, Vector3.new(0.6, 0.5, 0.5), Color3.fromRGB(160, 60, 60), lowerTorso, Vector3.new(0, 0, -0.1))

	----------------------------------------------------------------------
	-- OVERHEAD BILLBOARD GUI (STATUS &amp; ANATOMY INFO)
	----------------------------------------------------------------------
	local bb = Instance.new(&quot;BillboardGui&quot;)
	bb.Name = &quot;StatusGui&quot;
	bb.Size = UDim2.new(5, 0, 1.8, 0)
	bb.StudsOffset = Vector3.new(0, 2.5, 0)
	bb.AlwaysOnTop = true
	bb.Adornee = head
	bb.Parent = head

	local frame = Instance.new(&quot;Frame&quot;)
	frame.Size = UDim2.new(1, 0, 1, 0)
	frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
	frame.BackgroundTransparency = 0.3
	frame.BorderSizePixel = 0
	frame.Parent = bb

	local uicorner = Instance.new(&quot;UICorner&quot;)
	uicorner.CornerRadius = UDim.new(0, 6)
	uicorner.Parent = frame

	local titleLabel = Instance.new(&quot;TextLabel&quot;)
	titleLabel.Name = &quot;Title&quot;
	titleLabel.Size = UDim2.new(1, 0, 0.35, 0)
	titleLabel.BackgroundTransparency = 1
	titleLabel.Text = dummy.Name
	titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	titleLabel.Font = Enum.Font.GothamBold
	titleLabel.TextScaled = true
	titleLabel.Parent = frame

	local hpLabel = Instance.new(&quot;TextLabel&quot;)
	hpLabel.Name = &quot;HpLabel&quot;
	hpLabel.Size = UDim2.new(1, 0, 0.3, 0)
	hpLabel.Position = UDim2.new(0, 0, 0.35, 0)
	hpLabel.BackgroundTransparency = 1
	hpLabel.Text = &quot;HP: 100/100 | СТАТУС: В НОРМЕ&quot;
	hpLabel.TextColor3 = Color3.fromRGB(100, 255, 120)
	hpLabel.Font = Enum.Font.GothamMedium
	hpLabel.TextScaled = true
	hpLabel.Parent = frame

	local ragdollLabel = Instance.new(&quot;TextLabel&quot;)
	ragdollLabel.Name = &quot;RagdollLabel&quot;
	ragdollLabel.Size = UDim2.new(1, 0, 0.3, 0)
	ragdollLabel.Position = UDim2.new(0, 0, 0.68, 0)
	ragdollLabel.BackgroundTransparency = 1
	ragdollLabel.Text = &quot;[F/E: РЭГДОЛЛ] [R: ВОССТАНОВИТЬ]&quot;
	ragdollLabel.TextColor3 = Color3.fromRGB(255, 200, 80)
	ragdollLabel.Font = Enum.Font.Gotham
	ragdollLabel.TextScaled = true
	ragdollLabel.Parent = frame

	-- Update status GUI on health change or ragdoll toggle
	local function updateGui()
		if humanoid.Health &lt;= 0 then
			hpLabel.Text = &quot;☠️ МЕРТВ (ПОЛНЫЙ РЭГДОЛЛ)&quot;
			hpLabel.TextColor3 = Color3.fromRGB(255, 50, 50)
		else
			local isRag = RagdollModule.IsRagdolled(dummy)
			hpLabel.Text = string.format(&quot;HP: %d/100 | %s&quot;, math.floor(humanoid.Health), isRag and &quot;🌀 РЭГДОЛЛ&quot; or &quot;🧍 СТОИТ&quot;)
			hpLabel.TextColor3 = isRag and Color3.fromRGB(255, 140, 50) or Color3.fromRGB(100, 255, 120)
		end
	end

	humanoid.HealthChanged:Connect(updateGui)
	local isRagVal = dummy:FindFirstChild(&quot;IsRagdolled&quot;) :: BoolValue?
	if isRagVal then
		isRagVal.Changed:Connect(updateGui)
	end

	----------------------------------------------------------------------
	-- PROXIMITY PROMPTS FOR INTERACTION
	----------------------------------------------------------------------
	-- [E] Toggle Ragdoll
	local togglePrompt = Instance.new(&quot;ProximityPrompt&quot;)
	togglePrompt.Name = &quot;ToggleRagdollPrompt&quot;
	togglePrompt.ActionText = &quot;Переключить рэгдолл&quot;
	togglePrompt.ObjectText = dummy.Name
	togglePrompt.KeyboardKeyCode = Enum.KeyCode.E
	togglePrompt.HoldDuration = 0
	togglePrompt.MaxActivationDistance = 12
	togglePrompt.RequiresLineOfSight = false
	togglePrompt.Parent = upperTorso

	togglePrompt.Triggered:Connect(function(player)
		RagdollModule.ToggleRagdoll(dummy)
		updateGui()
	end)

	-- [R] Revive / Reset Dummy
	local resetPrompt = Instance.new(&quot;ProximityPrompt&quot;)
	resetPrompt.Name = &quot;ResetDummyPrompt&quot;
	resetPrompt.ActionText = &quot;Восстановить / Оживить&quot;
	resetPrompt.ObjectText = dummy.Name
	resetPrompt.KeyboardKeyCode = Enum.KeyCode.R
	resetPrompt.HoldDuration = 0.5
	resetPrompt.MaxActivationDistance = 12
	resetPrompt.RequiresLineOfSight = false
	resetPrompt.Parent = upperTorso

	resetPrompt.Triggered:Connect(function(player)
		humanoid.Health = humanoid.MaxHealth
		RagdollModule.SetRagdoll(dummy, false)
		hrp.CFrame = spawnCFrame
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		updateGui()
	end)

	-- Set up ragdoll physics constraints
	RagdollModule.SetupCharacter(dummy)

	dummy.Parent = Workspace
	return dummy
end

-- Initialize default dummies in testing arena
task.spawn(function()
	task.wait(1)

	-- 1. Main C.A.R.L. Anatomy Dummy on the shooting range pedestal
	DummyManager.CreateCarlDummy(CFrame.new(0, 5, -25), &quot;C.A.R.L. (Лабораторный Манекен)&quot;)

	-- 2. Dummy at the top of Stunt Stairs (ready to tumble down!)
	DummyManager.CreateCarlDummy(CFrame.new(35, 34, -15), &quot;Манекен (Вершина Лестницы)&quot;)

	-- 3. Dummy at the top of Mega Ramp
	DummyManager.CreateCarlDummy(CFrame.new(-35, 28, -15), &quot;Манекен (Вершина Горки)&quot;)
end)

return DummyManager
</string>
      </Properties>
    </Item>
    <Item class="Script" referent="RBX_20">
      <Properties>
        <string name="Name">MapBuilder</string>
        <string name="Source">--!strict
-- MapBuilder.server.luau
-- Builds the Ragdoll &amp; Ballistics Testing Laboratory (Stunt Stairs, Mega Ramp, Trampoline, Kinetic Spinner)

local Workspace = game:GetService(&quot;Workspace&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local MapBuilder = {}

local function createPart(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material?, parent: Instance): Part
	local part = Instance.new(&quot;Part&quot;)
	part.Name = name
	part.Size = size
	part.Position = position
	part.Anchored = true
	part.CanCollide = true
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	return part
end

function MapBuilder.BuildLab()
	local mapFolder = Workspace:FindFirstChild(&quot;RagdollLabMap&quot;)
	if mapFolder then
		return -- Map already built
	end

	mapFolder = Instance.new(&quot;Folder&quot;)
	mapFolder.Name = &quot;RagdollLabMap&quot;
	mapFolder.Parent = Workspace

	----------------------------------------------------------------------
	-- 1. BASEPLATE &amp; MAIN ARENA FLOOR
	----------------------------------------------------------------------
	local baseplate = createPart(&quot;LabFloor&quot;, Vector3.new(512, 10, 512), Vector3.new(0, -5, 0), Color3.fromRGB(28, 30, 36), Enum.Material.Concrete, mapFolder)

	-- Grid texture on floor
	local texture = Instance.new(&quot;Texture&quot;)
	texture.Texture = &quot;rbxassetid://6372755229&quot; -- Grid texture
	texture.Face = Enum.NormalId.Top
	texture.StudsPerTileU = 8
	texture.StudsPerTileV = 8
	texture.Transparency = 0.6
	texture.Parent = baseplate

	----------------------------------------------------------------------
	-- 2. SPAWN PLATFORM
	----------------------------------------------------------------------
	local spawnLoc = Instance.new(&quot;SpawnLocation&quot;)
	spawnLoc.Name = &quot;LabSpawn&quot;
	spawnLoc.Size = Vector3.new(16, 1, 16)
	spawnLoc.Position = Vector3.new(0, 0.5, 15)
	spawnLoc.Anchored = true
	spawnLoc.CanCollide = true
	spawnLoc.Color = Color3.fromRGB(45, 50, 60)
	spawnLoc.Material = Enum.Material.SmoothPlastic
	spawnLoc.Duration = 0
	spawnLoc.Parent = mapFolder

	local spawnDecal = Instance.new(&quot;Decal&quot;)
	spawnDecal.Face = Enum.NormalId.Top
	spawnDecal.Texture = &quot;rbxassetid://1212882264&quot;
	spawnDecal.Parent = spawnLoc

	-- Neon border for spawn
	createPart(&quot;SpawnBorder&quot;, Vector3.new(16.4, 0.4, 16.4), Vector3.new(0, 0.3, 15), Color3.fromRGB(0, 180, 255), Enum.Material.Neon, mapFolder)

	----------------------------------------------------------------------
	-- 3. THE STUNT STAIRS (30 STEPS TALL)
	----------------------------------------------------------------------
	local stairsFolder = Instance.new(&quot;Folder&quot;)
	stairsFolder.Name = &quot;StuntStairs&quot;
	stairsFolder.Parent = mapFolder

	local startX = 35
	local startZ = 15
	local stepWidth = 12
	local stepDepth = 2.2
	local stepHeight = 1.05
	local numSteps = 30

	for i = 1, numSteps do
		local y = i * stepHeight
		local z = startZ - (i * stepDepth)
		local stepColor = (i % 2 == 0) and Color3.fromRGB(50, 55, 65) or Color3.fromRGB(40, 44, 52)
		local step = createPart(&quot;Step_&quot; .. i, Vector3.new(stepWidth, stepHeight, stepDepth), Vector3.new(startX, y - (stepHeight / 2), z), stepColor, Enum.Material.Metal, stairsFolder)

		-- Yellow warning stripes on step edge
		if i % 5 == 0 then
			createPart(&quot;StairStripe_&quot; .. i, Vector3.new(stepWidth, 0.1, 0.4), Vector3.new(startX, y + 0.05, z + (stepDepth / 2) - 0.2), Color3.fromRGB(240, 180, 20), Enum.Material.Neon, stairsFolder)
		end
	end

	-- Top Observation Platform
	local topPlatform = createPart(&quot;StairsTopPlatform&quot;, Vector3.new(16, 2, 14), Vector3.new(startX, numSteps * stepHeight - 1, startZ - (numSteps * stepDepth) - 7), Color3.fromRGB(35, 40, 48), Enum.Material.Metal, stairsFolder)

	-- Platform railing with open tumble exit facing stairs
	createPart(&quot;RailBack&quot;, Vector3.new(16, 4, 1), topPlatform.Position + Vector3.new(0, 3, -7), Color3.fromRGB(200, 200, 200), Enum.Material.SmoothPlastic, stairsFolder)
	createPart(&quot;RailLeft&quot;, Vector3.new(1, 4, 14), topPlatform.Position + Vector3.new(-8, 3, 0), Color3.fromRGB(200, 200, 200), Enum.Material.SmoothPlastic, stairsFolder)
	createPart(&quot;RailRight&quot;, Vector3.new(1, 4, 14), topPlatform.Position + Vector3.new(8, 3, 0), Color3.fromRGB(200, 200, 200), Enum.Material.SmoothPlastic, stairsFolder)

	----------------------------------------------------------------------
	-- 4. THE MEGA SLIDE / RAMP
	----------------------------------------------------------------------
	local rampFolder = Instance.new(&quot;Folder&quot;)
	rampFolder.Name = &quot;MegaRamp&quot;
	rampFolder.Parent = mapFolder

	local rampX = -35
	local rampTopPos = Vector3.new(rampX, 26, -20)
	local rampBottomPos = Vector3.new(rampX, 1, 15)

	-- Slide surface (Angled WedgePart)
	local rampWedge = Instance.new(&quot;WedgePart&quot;)
	rampWedge.Name = &quot;SlideWedge&quot;
	rampWedge.Size = Vector3.new(14, 26, 40)
	rampWedge.CFrame = CFrame.new(rampX, 13, -2.5) * CFrame.Angles(0, math.pi, 0)
	rampWedge.Anchored = true
	rampWedge.Color = Color3.fromRGB(0, 120, 215)
	rampWedge.Material = Enum.Material.Ice -- Super slippery for maximum ragdoll sliding!
	rampWedge.Parent = rampFolder

	-- Top staging platform for ramp
	createPart(&quot;RampTopPlatform&quot;, Vector3.new(16, 2, 12), rampTopPos + Vector3.new(0, -1, -8), Color3.fromRGB(40, 45, 55), Enum.Material.Metal, rampFolder)

	-- Jump kicker at bottom of slide
	local kicker = Instance.new(&quot;WedgePart&quot;)
	kicker.Name = &quot;SlideKicker&quot;
	kicker.Size = Vector3.new(14, 3, 6)
	kicker.CFrame = CFrame.new(rampX, 1.5, 20)
	kicker.Anchored = true
	kicker.Color = Color3.fromRGB(255, 140, 0)
	kicker.Material = Enum.Material.SmoothPlastic
	kicker.Parent = rampFolder

	----------------------------------------------------------------------
	-- 5. SUPER TRAMPOLINE / LAUNCHPAD
	----------------------------------------------------------------------
	local trampoline = createPart(&quot;SuperTrampoline&quot;, Vector3.new(18, 1.2, 18), Vector3.new(0, 0.6, -55), Color3.fromRGB(0, 255, 180), Enum.Material.Neon, mapFolder)

	local bounceCooldown = false
	trampoline.Touched:Connect(function(hit)
		if bounceCooldown then return end
		local char = hit:FindFirstAncestorOfClass(&quot;Model&quot;)
		if char and char:FindFirstChildOfClass(&quot;Humanoid&quot;) then
			bounceCooldown = true
			task.delay(0.25, function() bounceCooldown = false end)

			local hrp = char:FindFirstChild(&quot;HumanoidRootPart&quot;) or hit
			if hrp and hrp:IsA(&quot;BasePart&quot;) then
				-- Fling into air with huge upward velocity!
				hrp.AssemblyLinearVelocity = Vector3.new(math.random(-10, 10), 95, math.random(-25, -10))

				-- Create flash effect
				local flash = Instance.new(&quot;PointLight&quot;)
				flash.Color = Color3.fromRGB(0, 255, 200)
				flash.Range = 25
				flash.Brightness = 10
				flash.Parent = trampoline
				TweenService:Create(flash, TweenInfo.new(0.5), { Brightness = 0 }):Play()
				game:GetService(&quot;Debris&quot;):AddItem(flash, 0.6)
			end
		end
	end)

	-- Trampoline Frame
	createPart(&quot;TrampolineBorder&quot;, Vector3.new(20, 1.5, 20), Vector3.new(0, 0.5, -55), Color3.fromRGB(20, 25, 30), Enum.Material.Metal, mapFolder)

	----------------------------------------------------------------------
	-- 6. KINETIC SWEEPER / SPINNER (KNOCKS PLAYERS &amp; DUMMIES OVER)
	----------------------------------------------------------------------
	local spinnerFolder = Instance.new(&quot;Folder&quot;)
	spinnerFolder.Name = &quot;KineticSpinner&quot;
	spinnerFolder.Parent = mapFolder

	local spinnerCenter = Vector3.new(0, 1, -100)

	-- Spinner circular ring arena
	createPart(&quot;SpinnerArena&quot;, Vector3.new(45, 1, 45), spinnerCenter, Color3.fromRGB(35, 38, 45), Enum.Material.Concrete, spinnerFolder)

	-- Rotating Pillar
	local post = createPart(&quot;SpinnerPost&quot;, Vector3.new(3, 4, 3), spinnerCenter + Vector3.new(0, 2, 0), Color3.fromRGB(180, 30, 30), Enum.Material.Metal, spinnerFolder)

	-- Rotating Bar
	local bar = Instance.new(&quot;Part&quot;)
	bar.Name = &quot;SweeperBar&quot;
	bar.Size = Vector3.new(38, 1.8, 1.8)
	bar.Position = spinnerCenter + Vector3.new(0, 2, 0)
	bar.Anchored = true
	bar.CanCollide = true
	bar.Color = Color3.fromRGB(255, 200, 30)
	bar.Material = Enum.Material.Neon
	bar.Parent = spinnerFolder

	-- Rotate continuously
	task.spawn(function()
		local angle = 0
		while bar and bar.Parent do
			angle = (angle + 1.8) % 360
			bar.CFrame = CFrame.new(spinnerCenter + Vector3.new(0, 2, 0)) * CFrame.Angles(0, math.rad(angle), 0)
			task.wait(0.03)
		end
	end)

	----------------------------------------------------------------------
	-- 7. SHOOTING RANGE BENCH &amp; TARGET MARKERS
	----------------------------------------------------------------------
	local shootingFolder = Instance.new(&quot;Folder&quot;)
	shootingFolder.Name = &quot;ShootingRange&quot;
	shootingFolder.Parent = mapFolder

	-- Pedestal for C.A.R.L. Dummy
	createPart(&quot;CarlPedestal&quot;, Vector3.new(8, 1, 8), Vector3.new(0, 0.5, -25), Color3.fromRGB(50, 55, 65), Enum.Material.Metal, shootingFolder)
	createPart(&quot;PedestalGlow&quot;, Vector3.new(8.4, 0.2, 8.4), Vector3.new(0, 0.2, -25), Color3.fromRGB(255, 60, 60), Enum.Material.Neon, shootingFolder)

	-- Shooting stall counter / bench
	createPart(&quot;FiringBench&quot;, Vector3.new(16, 3, 3), Vector3.new(0, 1.5, -5), Color3.fromRGB(40, 45, 52), Enum.Material.WoodPlanks, shootingFolder)

	print(&quot;[Server] Ragdoll Testing Lab Map generated.&quot;)
end

-- Generate map on server start
MapBuilder.BuildLab()

return MapBuilder
</string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="RBX_21">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="RBX_22">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="RBX_23">
        <Properties>
          <string name="Name">RagdollController</string>
          <string name="Source">--!strict
-- RagdollController.client.luau
-- Handles player input for [F] Ragdoll Toggle, [X] X-Ray Mode, and Camera Tracking

local UserInputService = game:GetService(&quot;UserInputService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local Players = game:GetService(&quot;Players&quot;)
local Workspace = game:GetService(&quot;Workspace&quot;)

local LocalPlayer = Players.LocalPlayer
local Camera = Workspace.CurrentCamera

local ToggleRagdollRemote = ReplicatedStorage:WaitForChild(&quot;ToggleRagdoll&quot;) :: RemoteEvent
local ToggleXRayRemote = ReplicatedStorage:WaitForChild(&quot;ToggleXRay&quot;) :: RemoteEvent

local debounce = false

-- Function to request ragdoll toggle
local function requestRagdollToggle()
	if debounce then return end
	debounce = true
	task.delay(0.35, function()
		debounce = false
	end)

	ToggleRagdollRemote:FireServer()
end

-- Listen for keyboard inputs
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end

	-- [F] Key: Toggle Ragdoll for self
	if input.KeyCode == Enum.KeyCode.F then
		requestRagdollToggle()
	end

	-- [X] Key: Toggle X-Ray Organ View on Dummies
	if input.KeyCode == Enum.KeyCode.X then
		ToggleXRayRemote:FireServer()
	end
end)

-- Bind custom event for UI clicks
local BindableToggle = Instance.new(&quot;BindableEvent&quot;)
BindableToggle.Name = &quot;ClientToggleRagdoll&quot;
BindableToggle.Parent = script

BindableToggle.Event:Connect(function()
	requestRagdollToggle()
end)

print(&quot;[Client] RagdollController loaded. Press [F] to Ragdoll!&quot;)
</string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="RBX_24">
        <Properties>
          <string name="Name">RagdollHud</string>
          <string name="Source">--!strict
-- RagdollHud.client.luau
-- Displays controls helper, ragdoll status badge, X-Ray toggle button, and Project C.A.R.L. organ hit notifications

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild(&quot;PlayerGui&quot;)

local OrganHitRemote = ReplicatedStorage:WaitForChild(&quot;OrganHitEvent&quot;) :: RemoteEvent
local ToggleRagdollRemote = ReplicatedStorage:WaitForChild(&quot;ToggleRagdoll&quot;) :: RemoteEvent
local ToggleXRayRemote = ReplicatedStorage:WaitForChild(&quot;ToggleXRay&quot;) :: RemoteEvent

-- Create ScreenGui
local screenGui = Instance.new(&quot;ScreenGui&quot;)
screenGui.Name = &quot;RagdollHudGui&quot;
screenGui.ResetOnSpawn = false
screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
screenGui.Parent = PlayerGui

----------------------------------------------------------------------
-- TOP TITLE BANNER
----------------------------------------------------------------------
local topBanner = Instance.new(&quot;Frame&quot;)
topBanner.Name = &quot;TopBanner&quot;
topBanner.Size = UDim2.new(0, 480, 0, 42)
topBanner.Position = UDim2.new(0.5, -240, 0, 12)
topBanner.BackgroundColor3 = Color3.fromRGB(18, 20, 24)
topBanner.BackgroundTransparency = 0.25
topBanner.BorderSizePixel = 0
topBanner.Parent = screenGui

local bannerCorner = Instance.new(&quot;UICorner&quot;)
bannerCorner.CornerRadius = UDim.new(0, 8)
bannerCorner.Parent = topBanner

local bannerStroke = Instance.new(&quot;UIStroke&quot;)
bannerStroke.Color = Color3.fromRGB(0, 180, 255)
bannerStroke.Thickness = 1.5
bannerStroke.Transparency = 0.4
bannerStroke.Parent = topBanner

local titleText = Instance.new(&quot;TextLabel&quot;)
titleText.Size = UDim2.new(1, 0, 1, 0)
titleText.BackgroundTransparency = 1
titleText.Text = &quot;PROJECT C.A.R.L. // ROBLOX RAGDOLL ENGINE&quot;
titleText.TextColor3 = Color3.fromRGB(240, 245, 255)
titleText.Font = Enum.Font.GothamBold
titleText.TextSize = 16
titleText.Parent = topBanner

----------------------------------------------------------------------
-- CONTROLS &amp; STATUS CARD (LEFT SIDE)
----------------------------------------------------------------------
local card = Instance.new(&quot;Frame&quot;)
card.Name = &quot;ControlsCard&quot;
card.Size = UDim2.new(0, 290, 0, 210)
card.Position = UDim2.new(0, 16, 0.5, -105)
card.BackgroundColor3 = Color3.fromRGB(20, 22, 28)
card.BackgroundTransparency = 0.2
card.BorderSizePixel = 0
card.Parent = screenGui

local cardCorner = Instance.new(&quot;UICorner&quot;)
cardCorner.CornerRadius = UDim.new(0, 8)
cardCorner.Parent = card

local cardStroke = Instance.new(&quot;UIStroke&quot;)
cardStroke.Color = Color3.fromRGB(80, 90, 110)
cardStroke.Thickness = 1
cardStroke.Transparency = 0.5
cardStroke.Parent = card

local cardTitle = Instance.new(&quot;TextLabel&quot;)
cardTitle.Size = UDim2.new(1, -20, 0, 26)
cardTitle.Position = UDim2.new(0, 10, 0, 8)
cardTitle.BackgroundTransparency = 1
cardTitle.Text = &quot;⚙️ УПРАВЛЕНИЕ И СТАТУС&quot;
cardTitle.TextColor3 = Color3.fromRGB(0, 200, 255)
cardTitle.Font = Enum.Font.GothamBold
cardTitle.TextSize = 14
cardTitle.TextXAlignment = Enum.TextXAlignment.Left
cardTitle.Parent = card

-- [F] Ragdoll Button
local fButton = Instance.new(&quot;TextButton&quot;)
fButton.Name = &quot;RagdollButton&quot;
fButton.Size = UDim2.new(1, -20, 0, 36)
fButton.Position = UDim2.new(0, 10, 0, 38)
fButton.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
fButton.BorderSizePixel = 0
fButton.Text = &quot;🌀 [F] ТВОЙ РЭГДОЛЛ: ВЫКЛ&quot;
fButton.TextColor3 = Color3.fromRGB(100, 255, 120)
fButton.Font = Enum.Font.GothamBold
fButton.TextSize = 13
fButton.Parent = card

local fCorner = Instance.new(&quot;UICorner&quot;)
fCorner.CornerRadius = UDim.new(0, 6)
fCorner.Parent = fButton

fButton.MouseButton1Click:Connect(function()
	ToggleRagdollRemote:FireServer()
end)

-- [X] X-Ray Button
local xButton = Instance.new(&quot;TextButton&quot;)
xButton.Name = &quot;XRayButton&quot;
xButton.Size = UDim2.new(1, -20, 0, 32)
xButton.Position = UDim2.new(0, 10, 0, 80)
xButton.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
xButton.BorderSizePixel = 0
xButton.Text = &quot;👁️ [X] РЕНТГЕН ОРГАНОВ C.A.R.L.&quot;
xButton.TextColor3 = Color3.fromRGB(255, 200, 80)
xButton.Font = Enum.Font.GothamBold
xButton.TextSize = 12
xButton.Parent = card

local xCorner = Instance.new(&quot;UICorner&quot;)
xCorner.CornerRadius = UDim.new(0, 6)
xCorner.Parent = xButton

xButton.MouseButton1Click:Connect(function()
	ToggleXRayRemote:FireServer()
end)

-- Instruction list label
local infoLabel = Instance.new(&quot;TextLabel&quot;)
infoLabel.Size = UDim2.new(1, -20, 0, 80)
infoLabel.Position = UDim2.new(0, 10, 0, 120)
infoLabel.BackgroundTransparency = 1
infoLabel.Text = &quot;• [F] — Включить / встать из рэгдолла\n• [E] на манекене — Уронить / поднять\n• [R] на манекене — Восстановить HP\n• [1, 2, 3] — Пистолет, Дробовик, Толчок&quot;
infoLabel.TextColor3 = Color3.fromRGB(180, 190, 205)
infoLabel.Font = Enum.Font.Gotham
infoLabel.TextSize = 11
infoLabel.TextXAlignment = Enum.TextXAlignment.Left
infoLabel.TextYAlignment = Enum.TextYAlignment.Top
infoLabel.Parent = card

-- Monitor player ragdoll state to update button badge
task.spawn(function()
	while true do
		local char = LocalPlayer.Character
		if char then
			local isRag = char:FindFirstChild(&quot;IsRagdolled&quot;) :: BoolValue?
			if isRag and isRag.Value then
				fButton.Text = &quot;🌀 [F] ТВОЙ РЭГДОЛЛ: АКТИВЕН&quot;
				fButton.TextColor3 = Color3.fromRGB(255, 120, 50)
				fButton.BackgroundColor3 = Color3.fromRGB(60, 25, 25)
			else
				fButton.Text = &quot;🧍 [F] ТВОЙ РЭГДОЛЛ: ВЫКЛ (СТОИТ)&quot;
				fButton.TextColor3 = Color3.fromRGB(100, 255, 120)
				fButton.BackgroundColor3 = Color3.fromRGB(30, 45, 35)
			end
		end
		task.wait(0.2)
	end
end)

----------------------------------------------------------------------
-- CRITICAL ORGAN HIT POPUP NOTIFICATIONS (PROJECT C.A.R.L. STYLE)
----------------------------------------------------------------------
local toastContainer = Instance.new(&quot;Frame&quot;)
toastContainer.Name = &quot;ToastContainer&quot;
toastContainer.Size = UDim2.new(0, 400, 0, 200)
toastContainer.Position = UDim2.new(0.5, -200, 0.2, 0)
toastContainer.BackgroundTransparency = 1
toastContainer.Parent = screenGui

OrganHitRemote.OnClientEvent:Connect(function(organData)
	local toast = Instance.new(&quot;Frame&quot;)
	toast.Size = UDim2.new(1, 0, 0, 40)
	toast.Position = UDim2.new(0, 0, 0, 0)
	toast.BackgroundColor3 = Color3.fromRGB(25, 15, 15)
	toast.BackgroundTransparency = 0.2
	toast.BorderSizePixel = 0
	toast.Parent = toastContainer

	local toastCorner = Instance.new(&quot;UICorner&quot;)
	toastCorner.CornerRadius = UDim.new(0, 6)
	toastCorner.Parent = toast

	local toastStroke = Instance.new(&quot;UIStroke&quot;)
	toastStroke.Color = organData.color or Color3.fromRGB(255, 50, 50)
	toastStroke.Thickness = 1.5
	toastStroke.Parent = toast

	local label = Instance.new(&quot;TextLabel&quot;)
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Text = organData.message or &quot;КРИТИЧЕСКОЕ ПОПАДАНИЕ!&quot;
	label.TextColor3 = organData.color or Color3.fromRGB(255, 255, 255)
	label.Font = Enum.Font.GothamBlack
	label.TextSize = 14
	label.Parent = toast

	-- Animate popup
	toast.Position = UDim2.new(0, 0, 0, -20)
	toast.BackgroundTransparency = 1
	label.TextTransparency = 1

	local popIn = TweenService:Create(toast, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 0, 0, 0),
		BackgroundTransparency = 0.2,
	})
	local labelFade = TweenService:Create(label, TweenInfo.new(0.25), { TextTransparency = 0 })
	popIn:Play()
	labelFade:Play()

	-- Fade out after 2.5 seconds
	task.delay(2.5, function()
		if toast and toast.Parent then
			local fadeOut = TweenService:Create(toast, TweenInfo.new(0.4), {
				Position = UDim2.new(0, 0, 0, -30),
				BackgroundTransparency = 1,
			})
			TweenService:Create(label, TweenInfo.new(0.4), { TextTransparency = 1 }):Play()
			fadeOut:Play()
			fadeOut.Completed:Connect(function()
				toast:Destroy()
			end)
		end
	end)
end)

print(&quot;[Client] Ragdoll HUD loaded.&quot;)
</string>
        </Properties>
      </Item>
